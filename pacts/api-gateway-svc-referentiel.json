          "totalCentimes": 1268,
          "tranche": 3,
          "valideAu": null,
          "valideDu": "2026-01-01"
        },
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "matchingRules": {
          "body": {
            "$.partGardeCentimes": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
