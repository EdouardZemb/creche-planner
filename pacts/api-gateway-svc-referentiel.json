        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/grilles/applicable",
        "query": {
          "date": [
            "2026-09-15"
          ],
          "mode": [
            "CANTINE"
          ],
          "tranche": [
            "3"
          ]
        }
      },
