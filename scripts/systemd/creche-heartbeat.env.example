# ===========================================================================
# creche-heartbeat.env.example — Modèle de /etc/creche-heartbeat.env (lot A4)
# ---------------------------------------------------------------------------
# À copier HORS dépôt sur le serveur (l'URL de ping est un SECRET) :
#   sudo cp scripts/systemd/creche-heartbeat.env.example /etc/creche-heartbeat.env
#   sudo chmod 600 /etc/creche-heartbeat.env   # root:root, lu par systemd (PID 1)
#   sudoedit /etc/creche-heartbeat.env         # remplir les valeurs réelles
# Format systemd EnvironmentFile= : KEY=valeur, une par ligne, pas d'expansion.
# ===========================================================================

# URL de ping du check externe (Healthchecks.io ou équivalent). REQUIS.
HEARTBEAT_PING_URL=https://hc-ping.com/<uuid-du-check>

# Si définie, le ping n'est envoyé que si cette URL répond 2xx : le battement
# atteste « serveur ET app OK ». Reprendre l'origine de SERVER_ORIGIN
# (.env.server). Optionnel (commenter pour un battement « machine seule »).
HEARTBEAT_HEALTH_URL=https://creche.testlens.dev/api/health

# CA du TLS « internal » de Caddy pour l'URL de santé, si SERVER_ORIGIN est en
# HTTPS avec le CA interne (inutile avec un certificat public). Optionnel.
# HEARTBEAT_CA_CERT=/home/<user>/creche-planner/caddy-root.crt
